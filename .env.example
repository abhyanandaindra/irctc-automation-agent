# Select the official IRCTC interface used for navigation smoke tests.
IRCTC_INTERFACE=nget

# Browser defaults to headed mode so future human checkpoints remain visible.
# Set to true only for controlled, non-interactive smoke execution.
IRCTC_HEADLESS=false

# Playwright action/navigation timeout in milliseconds.
IRCTC_TIMEOUT_MS=30000

# Optional local Chromium/Chrome executable path when Playwright's managed
# browser binary is unavailable in the development environment.
# BROWSER_EXECUTABLE_PATH=/usr/bin/google-chrome

# Optional, disabled by default. Creates one local diagnostic screenshot only
# for a rendered non-normal page state.
SMOKE_SCREENSHOT=false
